require "base64"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # xcodebuild needs the API key as a file on disk to authenticate
    # -allowProvisioningUpdates for automatic signing; the fastlane
    # api_key object alone only wires up pilot/deliver.
    key_filepath = File.join(Dir.mktmpdir, "AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8")
    File.write(key_filepath, Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]))

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: key_filepath,
      in_house: false
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: "BlackJack-swift.xcodeproj"
    )

    build_app(
      scheme: "BlackJack-swift",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_filepath} " \
              "-authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_ISSUER_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
